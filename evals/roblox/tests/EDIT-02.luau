local ret, env = load_answer()
local TeamScore = ret
local s = TeamScore.new({ "Red", "Blue" }, 10)
local seen = 0
s:onChanged(function() seen += 1 end)
check("an unknown team does not error", not throws(function() s:addPoints("Green", 5) end))
check("an unknown team changes nothing", s:get("Green") == nil and s:get("Red") == 0 and s:get("Blue") == 0)
s:addPoints("Red", 4)
check("points still count", s:get("Red") == 4 and seen >= 1)
s:addPoints("Blue", 10)
check("reaching the win score sets the winner", s.winner == "Blue")
s:addPoints("Red", 3)
s:addPoints("Blue", 3)
check("no points after a winner exists", s:get("Red") == 4 and s:get("Blue") == 10)
check("reset exists", type(s.reset) == "function")
s:reset()
check("reset puts every team back to 0 and clears the winner", s:get("Red") == 0 and s:get("Blue") == 0 and s.winner == nil)
s:addPoints("Red", 2)
check("points count again after reset", s:get("Red") == 2)
check("standings still sort by score", s:standings()[1].team == "Red")
