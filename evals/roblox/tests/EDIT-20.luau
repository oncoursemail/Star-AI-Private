local ret, env = load_answer()
local Flag = ret
local f = Flag.new("Red", 30)
check("a teammate cannot take their own flag from home", f:touch("r1", "Red", 0) == nil and f:isHome())
check("an enemy takes the flag", f:touch("b1", "Blue", 1) == "taken" and f.carrier == "b1")
f:drop({ x = 1, y = 2, z = 3 }, 10)
check("the carrier drops it", f.state == "dropped" and f.carrier == nil)
f:update(39)
check("still dropped before returnTime", f.state == "dropped")
f:update(40)
check("home after returnTime", f:isHome() and f.carrier == nil)
f:touch("b2", "Blue", 50)
f:drop({ x = 0, y = 0, z = 0 }, 55)
check("a teammate touching a dropped flag returns it", f:touch("r2", "Red", 56) == "returned" and f:isHome())
f:touch("b3", "Blue", 60)
check("capture still works", f:capture() == true and f:isHome())
