# STAR Home on her own PC: every Python package her abilities need (Windows x64, Python 3.12, RTX 4060 8 GB).
# Direct packages only. `python installer/star-home/pin_requirements.py` resolves the full tree and writes the exact
# versions with hashes to requirements-home.txt and requirements-home-torch.txt, which setup.cmd installs.
#!skip onnxruntime
#!torch 2.9.1 cu128

# star.home, star.computer, star.play, star.vtuber: screen, mouse, keyboard, Windows UI Automation, images
pillow>=13.0.0,<14
numpy>=2.4.6,<2.5
pyautogui>=0.9.54
# pyautogui is a source-only release and PyPI lists none of its dependencies: its setup.py asks for these
pymsgbox
pytweening>=1.0.4
pyscreeze>=0.1.21
pygetwindow>=0.0.5
pyrect                             # needed by pygetwindow
mouseinfo
pyperclip                          # needed by mouseinfo
