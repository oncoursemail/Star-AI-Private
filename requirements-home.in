huggingface-hub>=0.21,<2          # faster-whisper 1.2.1 came out beside hub 1.x; hub 2.x (new HTTP stack) is untested with it
kokoro-onnx>=0.6.1,<0.7
# GPU build INSTEAD of the CPU onnxruntime (same import name; the CPU wheel would overwrite it). It is left out of the
# lock file on purpose (#!skip above); docs/STAR_VOICE_CALLS.md "GPU" has the reason. cuDNN and the CUDA runtime come as wheels.
onnxruntime-gpu[cuda,cudnn]==1.31.*
nvidia-cublas-cu12>=12,<13         # cuBLAS 12 for faster-whisper's CTranslate2 (cuDNN 9 arrives with onnxruntime-gpu[cudnn])

