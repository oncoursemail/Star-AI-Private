# Windows batch files must keep CRLF line endings: cmd.exe mis-resolves labels in LF-only files.
*.cmd -text

# Node scripts imported by the vitest suite carry a shebang; with CRLF the shebang line fails to parse there.
*.mjs text eol=lf

# Frozen source and evidence fixtures must not depend on Windows checkout settings.
tests/fixtures/shared_brain_retrieval.json text eol=lf
tests/fixtures/shared_brain_runtime_source_validation.json text eol=lf
tests/fixtures/shared_brain_sources/**/*.py text eol=lf

# Shell scripts run under bash (Git Bash on Windows, Linux servers): a CR at the end of a line breaks them.
*.sh text eol=lf

# STAR Brain files are copied to the Linux server as they are: with CRLF, models.ini paths end in a carriage return and
# server/brain/apply.sh check reports every model file as missing (seen 2026-10-14).
server/brain/** text eol=lf
# G1 API lock: the llama.cpp patch and the scripts are applied/run on Linux.
server/api_lock/** text eol=lf
server/api_lock/*.patch -whitespace
