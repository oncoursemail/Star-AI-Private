@@ -0,0 +1,121 @@
+"""Completion correctness and terminal-read checks; injected replies, no sockets, keys or model."""
+from __future__ import annotations
+
+import json
+import sys
+import unittest
+from pathlib import Path
+from threading import Event
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from launcher.litha import Litha, LithaIncomplete, LithaUnavailable
+from launcher.litha_session import LithaSession
+
+
+def event(content=None, finish=None):
+    return ("data: " + json.dumps({"choices": [{"delta": {"content": content}, "finish_reason": finish}]}) + "\n").encode()
+
+
+class Reply:
+    def __init__(self, lines, *, forbid_extra=False):
+        self.lines, self.forbid_extra = iter(lines), forbid_extra
+        self.closed, self.reads = False, 0
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        self.closed = True
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        self.reads += 1
+        try:
+            return next(self.lines)
+        except StopIteration:
+            if self.forbid_extra:
+                raise AssertionError("Terminal stop performed an unnecessary potentially blocking read") from None
+            raise
+
+
+class CompletionChecks(unittest.TestCase):
+    def model(self, reply):
+        instance = Litha(url="http://127.0.0.1:9", opener=lambda *_a, **_k: reply)
+        instance._key = lambda: "synthetic-test-credential"
+        return instance
+
+    def test_stop_without_done_or_connection_close_never_reads_again(self):
+        for lines in ([event("complete", "stop")], [event("complete"), event(finish="stop")]):
+            with self.subTest(events=len(lines)):
+                reply = Reply(lines, forbid_extra=True)
+                self.assertEqual(list(self.model(reply).ask_stream("Question")), ["complete"])
+                self.assertEqual(reply.reads, len(lines))
+                self.assertTrue(reply.closed)
+
+    def test_length_cannot_be_promoted_to_success_by_done(self):
+        reply = Reply([event("def unfinished():\n"), event("    return", "length"), b"data: [DONE]\n"])
+        stream = self.model(reply).ask_stream("Write code")
+        self.assertEqual(next(stream), "def unfinished():\n")
+        self.assertEqual(next(stream), "    return")
+        with self.assertRaisesRegex(LithaIncomplete, "output limit"):
+            next(stream)
+        self.assertEqual(reply.reads, 2)
+        self.assertTrue(reply.closed)
+
+    def test_actual_session_reports_one_incomplete_terminal_after_partial_chunks(self):
+        records = []
+        settled = Event()
+        reply = Reply([event("def partial():\n", "length"), b"data: [DONE]\n"])
+
+        def receive(raw):
+            records.append(json.loads(raw))
+            if records[-1]["type"] != "chunk":
+                settled.set()
+
+        session = LithaSession(self.model(reply), receive)
+        self.addCleanup(session.close)
+        self.assertTrue(session.request("cutoff", "Write code", "[]"))
+        self.assertTrue(settled.wait(3), "Synthetic worker did not publish a terminal receipt")
+        self.assertEqual([row["type"] for row in records], ["chunk", "incomplete"])
+        self.assertEqual(records[0]["text"], "def partial():\n")
+        self.assertIn("output limit", records[1]["text"])
+        self.assertTrue(reply.closed)
+
+    def test_unsupported_or_unknown_finish_never_succeeds(self):
+        for reason in ("tool_calls", "function_call", "content_filter", "unknown", "end_turn", "DO_NOT_EXPOSE"):
+            with self.subTest(reason=reason):
+                reply = Reply([event("partial"), event(finish=reason), b"data: [DONE]\n"])
+                with self.assertRaises(LithaUnavailable) as caught:
+                    list(self.model(reply).ask_stream("Question"))
+                self.assertNotIn("DO_NOT_EXPOSE", str(caught.exception))
+                self.assertTrue(reply.closed)
+
+    def test_invalid_utf8_is_not_silently_changed_inside_code(self):
+        for invalid in (b'data: {"choices":[{"delta":{"content":"bad\xffcode"}}]}\n',
+                        event("\ud800", "stop"), event("\udfff", "stop"), "not bytes"):
+            with self.subTest(shape=type(invalid).__name__):
+                reply = Reply([invalid, b"data: [DONE]\n"])
+                with self.assertRaisesRegex(LithaUnavailable, "invalid reply"):
+                    list(self.model(reply).ask_stream("Question"))
+                self.assertTrue(reply.closed)
+
+    def test_valid_unicode_and_legacy_done_remain_supported(self):
+        for lines in ([event("return '你好 🌱'", "stop")], [event("return '你好 🌱'"), b"data: [DONE]\n"]):
+            reply = Reply(lines)
+            self.assertEqual(list(self.model(reply).ask_stream("Question")), ["return '你好 🌱'"])
+            self.assertTrue(reply.closed)
+        literal_escape = "return '\\ud800'"
+        self.assertEqual(list(self.model(Reply([event(literal_escape, "stop")])).ask_stream("Question")), [literal_escape])
+
+    def test_empty_stop_is_still_empty_failure(self):
+        reply = Reply([event(finish="stop")], forbid_extra=True)
+        with self.assertRaisesRegex(LithaUnavailable, "no text"):
+            list(self.model(reply).ask_stream("Question"))
+        self.assertEqual(reply.reads, 1)
+        self.assertTrue(reply.closed)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
