@@ -0,0 +1,107 @@
+"""Lossless context wire-size comparison on temporary synthetic source; no model/tokenizer/network."""
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+import tempfile
+import unittest
+from dataclasses import replace
+from pathlib import Path
+from typing import ClassVar
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from launcher.litha import Litha, LithaUnavailable
+from launcher.litha_context import MAX_CAPSULE_CHARS, build_context
+
+
+def decoded(capsule):
+    start, end = capsule.index("{"), capsule.rindex("}") + 1
+    return json.loads(capsule[start:end]), capsule[:start], capsule[end:]
+
+
+class Reply:
+    def __enter__(self):
+        return iter([b'data: {"choices":[{"delta":{"content":"synthetic"},"finish_reason":"stop"}]}\n'])
+
+    def __exit__(self, *_):
+        return False
+
+
+def actual_request(context):
+    recorded = []
+    model = Litha(url="http://127.0.0.1:9", opener=lambda request, **_k: recorded.append(request.data) or Reply())
+    model._key = lambda: "synthetic-test-credential"
+    assert list(model.ask_stream("Explain the selected source.", context=context)) == ["synthetic"]
+    assert len(recorded) == 1
+    return recorded[0]
+
+
+class ContextWireChecks(unittest.TestCase):
+    reports: ClassVar[list[dict]] = []
+
+    def test_utf8_envelope_is_lossless_and_invalid_unicode_never_reads_key(self):
+        reads = []
+        model = Litha(url="http://127.0.0.1:9", opener=lambda *_a, **_k: self.fail("must not open"))
+        model._key = lambda: reads.append("key") or "synthetic-test-credential"
+        value = {"text": "你好 🌱 <tag> & \\", "controls": "a\nb\t\"c"}
+        request = model._request("/chat/completions", value)
+        payload = request.data
+        assert isinstance(payload, bytes)
+        self.assertEqual(json.loads(payload), value)
+        self.assertIn("你好 🌱".encode(), payload)
+        self.assertEqual(reads, ["key"])
+        reads.clear()
+        with self.assertRaisesRegex(LithaUnavailable, "Unicode"):
+            model._request("/chat/completions", {"text": "\ud800"})
+        self.assertEqual(reads, [])
+
+    def test_lossless_source_and_actual_request_comparison(self):
+        cases = {
+            "many_short_lines": ["x = 1\n" * 800] * 3,
+            "long_lines": ["#" + "x" * 7999] * 3,
+            "unicode_and_escaping": ["print('你好 🌱 <tag> & \\\\')\n" * 100] * 3,
+            "empty": [""],
+        }
+        with tempfile.TemporaryDirectory(prefix="litha-wire-check-") as directory:
+            root = Path(directory)
+            for name, texts in cases.items():
+                with self.subTest(case=name):
+                    paths = []
+                    for index, text in enumerate(texts):
+                        path = root / f"unit{index}.py"
+                        path.write_bytes(text.encode())
+                        paths.append(path)
+                    context = build_context(paths)
+                    payload, prefix, suffix = decoded(context.text)
+                    pretty = json.dumps(payload, ensure_ascii=False, indent=2)
+                    pretty = pretty.replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")
+                    baseline = replace(context, text=prefix + pretty + suffix)
+                    self.assertLessEqual(len(baseline.text), MAX_CAPSULE_CHARS, "Comparison must fit the old context limit")
+                    self.assertEqual(decoded(baseline.text)[0], payload)
+                    for index, text in enumerate(texts):
+                        self.assertEqual(payload["files"][index], {
+                            "file": index + 1, "name": paths[index].name,
+                            "lines": [f"{line}: {value}" for line, value in enumerate(text.splitlines(), 1)],
+                        })
+                        self.assertEqual(context.files[index].sha256, hashlib.sha256(text.encode()).hexdigest())
+                        self.assertEqual(paths[index].read_bytes(), text.encode())
+                    current = actual_request(context)
+                    # Reconstruct the prior request's default ASCII/spaced JSON envelope around its pretty capsule.
+                    old = json.dumps(json.loads(actual_request(baseline))).encode("utf-8")
+                    self.assertLess(len(current), len(old))
+                    self.assertEqual(context.files, baseline.files)
+                    self.assertNotIn(str(root), context.text)
+                    self.assertEqual(prefix, decoded(baseline.text)[1])
+                    self.assertEqual(suffix, decoded(baseline.text)[2])
+                    self.reports.append({"case": name, "source_bytes": sum(len(t.encode()) for t in texts),
+                                         "previous_request_bytes": len(old), "current_request_bytes": len(current),
+                                         "wire_reduction_percent": round(100 * (len(old) - len(current)) / len(old), 2)})
+
+
+if __name__ == "__main__":
+    suite = unittest.defaultTestLoader.loadTestsFromTestCase(ContextWireChecks)
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+    if result.wasSuccessful():
+        print(json.dumps({"kind": "synthetic_wire_bytes_not_token_or_latency_benchmark", "cases": ContextWireChecks.reports}))
+    raise SystemExit(not result.wasSuccessful())
