# All feature flags are OFF until deliberately enabled.
LITHA_LEMONADE_ENABLED=false
LITHA_ANYTHINGLLM_ENABLED=false
LITHA_ALLOW_REMOTE_AI=false
LITHA_LEMONADE_URL=http://127.0.0.1:13305/api/v1
LITHA_ANYTHINGLLM_URL=http://127.0.0.1:3001/api/v1
# Configure secrets in your local environment, NEVER commit values:
LITHA_LEMONADE_API_KEY=
LITHA_ANYTHINGLLM_API_KEY=
LITHA_AI_TIMEOUT=30
LITHA_MAX_PARALLEL_CHAT=1
LITHA_MAX_CONTEXT_CHARS=6000
LITHA_MAX_RETRIEVED_CHUNKS=4

# Queue admission timeout, separate from per-socket network timeout:
LITHA_QUEUE_TIMEOUT=5
LITHA_MAX_PROMPT_CHARS=50000
