  // RAMForge: GGML_NUMA_BLOCK=1 -> threads [k*n/N, (k+1)*n/N) on node k

+// ---- RAMForge per-core pinning (GGML_RF_PIN=1, with --numa distribute + GGML_NUMA_BLOCK=1) ----
+// Thread k of a node runs on ONE cpu: the node's physical cores sorted by (L3 id, cpu), then their SMT siblings.
+static int rf_pin = -1;
+static int rf_pin_cpus[GGML_NUMA_MAX_NODES][GGML_NUMA_MAX_CPUS];
+static int rf_pin_n[GGML_NUMA_MAX_NODES];
+static pthread_once_t rf_pin_once = PTHREAD_ONCE_INIT;
+static int rf_read_int(const char * path) {
+    FILE * f = fopen(path, "r"); int v = -1;
+    if (f) { if (fscanf(f, "%d", &v) != 1) v = -1; fclose(f); }
+    return v;
+}
+static void rf_pin_init_once(void) {
+    const char * e = getenv("GGML_RF_PIN");
+    rf_pin = (e && atoi(e) > 0) ? 1 : 0;
+    if (!rf_pin) return;
+    char path[256];
+    for (uint32_t n = 0; n < g_state.numa.n_nodes; n++) {
+        struct ggml_numa_node * node = &g_state.numa.nodes[n];
+        int cnt = 0;
+        for (int pass = 0; pass < 2; pass++) {
+            int l3s[GGML_NUMA_MAX_CPUS], cpus[GGML_NUMA_MAX_CPUS], m = 0;
+            for (uint32_t i = 0; i < node->n_cpus; i++) {
+                const int c = (int) node->cpus[i];
+                snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/topology/thread_siblings_list", c);
+                const int primary = rf_read_int(path) == c;
+                if ((pass == 0) != primary) continue;
+                snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/cache/index3/id", c);
+                l3s[m] = rf_read_int(path); cpus[m] = c; m++;
+            }
+            for (int a = 1; a < m; a++) {
+                const int l = l3s[a], c = cpus[a]; int b = a - 1;
+                while (b >= 0 && (l3s[b] > l || (l3s[b] == l && cpus[b] > c))) { l3s[b + 1] = l3s[b]; cpus[b + 1] = cpus[b]; b--; }
+                l3s[b + 1] = l; cpus[b + 1] = c;
+            }
+            for (int a = 0; a < m; a++) rf_pin_cpus[n][cnt++] = cpus[a];
+        }
+        rf_pin_n[n] = cnt;
+        fprintf(stderr, "ramforge pin: node %u cpus", n);
+        for (int a = 0; a < cnt; a++) fprintf(stderr, " %d", rf_pin_cpus[n][a]);
+        fprintf(stderr, "\n");
+    }
+}
