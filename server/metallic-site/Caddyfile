# metallic.club, served by Caddy on loopback only. The Cloudflare tunnel (cloudflared, see cloudflared-config.yml) is the
# only thing that talks to it and does HTTPS at Cloudflare's edge, so Caddy needs no certificate and no open port.
{
	admin localhost:2019
	auto_https off
}

:8088 {
	bind 127.0.0.1

	@www host www.metallic.club
	redir @www https://metallic.club{uri} 301

	root * /srv/metallic/dist
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://cdn.discordapp.com; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
	}

	# written every 2 minutes (metallic-live) or on each release (desktop and Quest manifests): never cached
	@fresh path /live/* /releases/latest.json /releases/quest.json /releases/android.json
	header @fresh Cache-Control "no-store"

	# installers carry their version in the file name, so they never change
	@installers path /releases/*.exe /releases/*.msi /releases/*.sig /releases/*.zip /releases/*.tar.gz /releases/*.dmg /releases/*.AppImage /releases/*.deb /releases/*.apk
	header @installers Cache-Control "public, max-age=31536000, immutable"

	# Two logs for metallic-live, nothing else is logged. No addresses or headers in either.
	# downloads.log: installer requests (Windows, AppImage, .deb, .dmg), with the user agent only (to keep the launcher's self-updates apart).
	# beats.log: people in Metallic now. A running launcher asks for /live/metallic.json every 2 minutes with a random
	# ID it made at start (X-Metallic-Session: kept in memory only, new every start); only that ID and the time are kept.
	# metallic-live counts the IDs seen in the last 5 minutes. Visitors' own requests for that file are not logged.
	@beat {
		path /live/metallic.json
		header X-Metallic-Session *
	}
	@unlogged {
		not path /releases/*.exe /releases/*.dmg /releases/*.AppImage /releases/*.deb
		not {
			path /live/metallic.json
			header X-Metallic-Session *
		}
	}
	log_skip @unlogged
	log_name @beat beats
	log_append @beat session {http.request.header.X-Metallic-Session}
	log_append ua {http.request.header.User-Agent}
	log {
		output file /var/log/caddy/downloads.log {
			mode 0644
			roll_disabled
		}
		format filter {
			request>headers delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>tls delete
		}
	}
	log beats {
		no_hostname
		output file /var/log/caddy/beats.log {
			mode 0644
			roll_size 1MiB
			roll_keep 1
			roll_uncompressed
		}
		format filter {
			request delete
			resp_headers delete
			user_id delete
			ua delete
		}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=3600"

	file_server {
		hide .*
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
