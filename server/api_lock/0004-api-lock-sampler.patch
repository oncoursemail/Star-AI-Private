+++ b/tests/test-api-lock.cpp
@@ -0,0 +1,71 @@
+// STAR patch 0004: runs the shared API lock cases (server/api_lock/cases.json in the STAR repo) against the C++ state
+// machine. The same file is run against star/api_lock.py by tests/test_api_lock.py.
+//   test-api-lock <cases.json>
+
+#include "api-lock.h"
+
+#include <nlohmann/json.hpp>
+
+#include <cstdio>
+#include <fstream>
+#include <sstream>
+
+using json = nlohmann::ordered_json;
+
+int main(int argc, char ** argv) {
+    if (argc != 2) {
+        fprintf(stderr, "usage: %s <cases.json>\n", argv[0]);
+        return 2;
+    }
+    std::ifstream f(argv[1], std::ios::binary);
+    std::stringstream ss;
+    ss << f.rdbuf();
+    const json data = json::parse(ss.str());
+
+    std::string error;
+    api_lock_table * table = api_lock_table_parse(data.at("table").dump(), error);
+    if (table == nullptr) {
+        fprintf(stderr, "table: %s\n", error.c_str());
+        return 1;
+    }
+
+    int failures = 0;
+    int checks   = 0;
+    for (const auto & c : data.at("cases")) {
+        const std::string name = c.at("name").get<std::string>();
+        api_lock_state * st = api_lock_state_init(table, c.at("mode").get<int>(), c.at("extra").get<std::vector<std::string>>());
+        api_lock_state_feed(st, c.at("text").get<std::string>());
+        for (const auto & p : c.at("allow")) {
+            checks++;
+            if (!api_lock_state_allows(st, p.get<std::string>())) {
+                printf("FAIL %s: should allow '%s'\n", name.c_str(), p.get<std::string>().c_str());
+                failures++;
+            }
+        }
+        for (const auto & p : c.at("deny")) {
+            checks++;
+            if (api_lock_state_allows(st, p.get<std::string>())) {
+                printf("FAIL %s: should deny '%s'\n", name.c_str(), p.get<std::string>().c_str());
+                failures++;
+            }
+        }
+        checks++;
+        const std::string forced = api_lock_state_forced(st);
+        if (forced != c.at("forced").get<std::string>()) {
+            printf("FAIL %s: forced '%s', expected '%s'\n", name.c_str(), forced.c_str(), c.at("forced").get<std::string>().c_str());
+            failures++;
+        }
+        // a clone answers the same
+        api_lock_state * copy = api_lock_state_clone(st);
+        checks++;
+        if (api_lock_state_forced(copy) != forced) {
+            printf("FAIL %s: clone differs\n", name.c_str());
+            failures++;
+        }
+        api_lock_state_free(copy);
+        api_lock_state_free(st);
+    }
+    api_lock_table_free(table);
+    printf("%d checks, %d failures\n", checks, failures);
+    return failures == 0 ? 0 : 1;
+}
