    "expires_in": {"type": "integer"}, "scope": {"type": "string"},
    "issued_token_type": {"const": "urn:ietf:params:oauth:token-type:access_token"}}},
   "RevokeRequest": {"type": "object", "required": ["token"], "additionalProperties": false, "properties": {"token": {"type": "string", "maxLength": 4096}}},
