    "created": {"type": "number"}, "last_used": {"type": ["number", "null"]}, "revoked": {"type": "boolean"}}},
   "KeyCreate": {"type": "object", "required": ["name", "scopes"], "additionalProperties": false, "properties": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9 ._-]{1,48}$"},
