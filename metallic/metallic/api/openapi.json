   "KeyList": {"type": "object", "required": ["keys"], "properties": {"keys": {"type": "array", "items": {"$ref": "#/components/schemas/Key"}}}},
   "EventEnvelope": {"type": "object", "required": ["id", "type", "created", "data"], "description": "Every webhook body. Headers: `Metallic-Event`, `Metallic-Delivery`, `Metallic-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, t + \".\" + body)>`. Reject a signature older than 5 minutes; deliveries are retried, so de-duplicate on `id`.", "properties": {
    "id": {"type": "string"}, "type": {"type": "string"}, "created": {"type": "number"}, "data": {"type": "object"}}},
   "PlayerEventPayload": {"allOf": [{"$ref": "#/components/schemas/EventEnvelope"}, {"type": "object", "properties": {"data": {"type": "object", "required": ["game", "server_id", "player"], "properties": {
