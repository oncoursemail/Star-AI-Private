{
 "openapi": "3.1.0",
 "info": {
  "title": "Metallic API",
  "version": "1.0.0",
  "summary": "One API for the Metallic launcher, website, game servers and (later) outside developers.",
  "description": "Metallic API v1 sits on top of Metallic accounts. Signed-in calls use a Metallic sign-in token (the launcher's access token) or a scoped token made from it with POST /v1/oauth/token. Game servers use server keys (`msk_...`) with their own scopes and rate limits. Minors' data is private by default: other parties never receive a minor's username or display name, and scoped tokens for minors can only read the minor's own profile.\n\nErrors always look like `{\"ok\": false, \"error\": \"code\", \"text\": \"plain words\"}`. A 429 carries `Retry-After` (seconds). Every response carries `RateLimit-Limit` and `RateLimit-Remaining` for the bucket that was charged.",
  "license": {"name": "Proprietary", "identifier": "LicenseRef-Metallic"}
 },
 "servers": [{"url": "https://{host}:8476", "variables": {"host": {"default": "metallic-api.local"}}}],
 "tags": [
  {"name": "account", "description": "The signed-in player: profile, friends, presence, invites."},
  {"name": "content", "description": "Public: news, games, releases, progress, project status."},
  {"name": "auth", "description": "Scoped tokens."},
  {"name": "servers", "description": "Game servers and backends (server keys)."},
  {"name": "webhooks", "description": "Signed event deliveries."},
  {"name": "admin", "description": "Owner and admins only."}
 ],
 "x-metallic-scopes": {
  "profile:read": {"kind": "user", "minors": true, "description": "Read your own profile (username, display name, role, age band)."},
  "profile:write": {"kind": "user", "minors": false, "description": "Change your display name."},
  "friends:read": {"kind": "user", "minors": false, "description": "Read your friends list and friend requests."},
  "friends:write": {"kind": "user", "minors": false, "description": "Send, accept, decline and remove friends."},
  "presence:read": {"kind": "user", "minors": false, "description": "Read what your friends are doing (only what they share with you)."},
  "presence:write": {"kind": "user", "minors": false, "description": "Set your own presence (online, playing RC, ...)."},
  "invites:read": {"kind": "user", "minors": false, "description": "Read your game invites."},
  "invites:write": {"kind": "user", "minors": false, "description": "Send and answer game invites."},
  "keys:admin": {"kind": "admin", "minors": false, "description": "Create and revoke server keys (owner/admin sign-in only, never delegated)."},
  "webhooks:manage": {"kind": "admin+server", "minors": false, "description": "Create, list and delete webhooks (server keys, or owner/admin sign-in)."},
  "servers:write": {"kind": "server", "minors": false, "description": "Report server heartbeats and player events for the key's games."},
  "players:read": {"kind": "server", "minors": false, "description": "Check a player's Metallic sign-in token (minors come back without names)."}
 },
 "x-metallic-rate-limits": {
  "anonymous": {"per_minute": 60, "burst": 30, "key": "client IP"},
  "user": {"per_minute": 120, "burst": 60, "key": "account"},
  "server_key": {"per_minute": "set per key (default 120)", "burst": "half the per-minute rate", "key": "server key"}
 },
 "paths": {
  "/health": {
   "get": {"operationId": "health", "tags": ["content"], "summary": "Service health", "security": [],
    "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}}
  },
  "/v1/openapi.json": {
   "get": {"operationId": "getOpenapi", "tags": ["content"], "summary": "This document", "security": [],
    "responses": {"200": {"description": "The OpenAPI document", "content": {"application/json": {"schema": {"type": "object"}}}}}}
  },
  "/v1/scopes": {
   "get": {"operationId": "listScopes", "tags": ["auth"], "summary": "Every scope and who may hold it", "security": [],
    "responses": {"200": {"description": "Scopes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScopeList"}}}}}}
  },
  "/v1/oauth/token": {
   "post": {"operationId": "exchangeToken", "tags": ["auth"], "summary": "Make a scoped token from a sign-in token",
    "description": "OAuth 2.0 token exchange (RFC 8693 style). `subject_token` is a Metallic sign-in token. The new token carries only the requested scopes, lives at most 15 minutes and never longer than the sign-in token, and stops working when the player signs out. Minors may only request `profile:read`. Admin scopes are never delegated.",
    "security": [], "x-metallic-rate": {"per_minute": 10, "burst": 10},
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenRequest"}}}},
    "responses": {"200": {"description": "Scoped token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenResponse"}}}},
     "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/oauth/revoke": {
   "post": {"operationId": "revokeToken", "tags": ["auth"], "summary": "Revoke a scoped token", "security": [],
    "x-metallic-rate": {"per_minute": 10, "burst": 10},
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevokeRequest"}}}},
    "responses": {"200": {"description": "Done (also when the token was unknown)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}}}
  },
  "/v1/me": {
   "get": {"operationId": "getMe", "tags": ["account"], "summary": "Your profile", "security": [{"metallicUser": ["profile:read"]}],
    "x-metallic-upstream": {"method": "GET", "path": "/v1/me"},
    "responses": {"200": {"description": "Profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Me"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}},
   "patch": {"operationId": "updateMe", "tags": ["account"], "summary": "Change your display name", "security": [{"metallicUser": ["profile:write"]}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/me/profile"},
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileUpdate"}}}},
    "responses": {"200": {"description": "Updated profile", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/friends": {
   "get": {"operationId": "listFriends", "tags": ["account"], "summary": "Friends and friend requests", "security": [{"metallicUser": ["friends:read"]}],
    "x-metallic-upstream": {"method": "GET", "path": "/v1/friends"},
    "responses": {"200": {"description": "Friends", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FriendsList"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/friends/requests": {
   "post": {"operationId": "sendFriendRequest", "tags": ["account"], "summary": "Ask a player to be friends", "security": [{"metallicUser": ["friends:write"]}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/friends/request"},
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Username"}}}},
    "responses": {"200": {"description": "State after the request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FriendState"}}}}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/friends/requests/{username}/accept": {
   "post": {"operationId": "acceptFriendRequest", "tags": ["account"], "summary": "Accept a friend request (sends friend.added)", "security": [{"metallicUser": ["friends:write"]}],
    "parameters": [{"$ref": "#/components/parameters/Username"}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/friends/accept", "body_from_path": ["username"]},
    "responses": {"200": {"description": "Now friends", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FriendState"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/friends/requests/{username}/decline": {
   "post": {"operationId": "declineFriendRequest", "tags": ["account"], "summary": "Decline an incoming or cancel an outgoing request", "security": [{"metallicUser": ["friends:write"]}],
    "parameters": [{"$ref": "#/components/parameters/Username"}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/friends/decline", "body_from_path": ["username"]},
    "responses": {"200": {"description": "Declined", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FriendState"}}}}}}
  },
  "/v1/friends/{username}": {
   "delete": {"operationId": "removeFriend", "tags": ["account"], "summary": "Remove a friend", "security": [{"metallicUser": ["friends:write"]}],
    "parameters": [{"$ref": "#/components/parameters/Username"}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/friends/remove", "body_from_path": ["username"]},
    "responses": {"200": {"description": "Removed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FriendState"}}}}}}
  },
  "/v1/presence": {
   "get": {"operationId": "listPresence", "tags": ["account"], "summary": "What your friends are doing", "description": "Only what each friend shares with you; minors share with friends only.", "security": [{"metallicUser": ["presence:read"]}],
    "x-metallic-upstream": {"method": "GET", "path": "/v1/presence"},
    "responses": {"200": {"description": "Presence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PresenceList"}}}}}}
  },
  "/v1/me/presence": {
   "put": {"operationId": "setPresence", "tags": ["account"], "summary": "Set your presence", "security": [{"metallicUser": ["presence:write"]}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/presence"},
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PresenceUpdate"}}}},
    "responses": {"200": {"description": "Saved; refresh before `ttl` seconds", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PresenceSaved"}}}}, "400": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/invites": {
   "get": {"operationId": "listInvites", "tags": ["account"], "summary": "Your open game invites", "security": [{"metallicUser": ["invites:read"]}],
    "x-metallic-upstream": {"method": "GET", "path": "/v1/invites"},
    "responses": {"200": {"description": "Invites", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InviteList"}}}}}},
   "post": {"operationId": "sendInvite", "tags": ["account"], "summary": "Invite a friend to a game", "description": "Invites carry only a game and a target id: no free text.", "security": [{"metallicUser": ["invites:write"]}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/invites"},
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InviteCreate"}}}},
    "responses": {"201": {"description": "Sent", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InviteSent"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/invites/{invite_id}/accept": {
   "post": {"operationId": "acceptInvite", "tags": ["account"], "summary": "Accept an invite", "security": [{"metallicUser": ["invites:write"]}],
    "parameters": [{"$ref": "#/components/parameters/InviteId"}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/invites/{invite_id}/accept"},
    "responses": {"200": {"description": "Accepted; join `target` in `game`", "content": {"application/json": {"schema": {"type": "object"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/invites/{invite_id}/decline": {
   "post": {"operationId": "declineInvite", "tags": ["account"], "summary": "Decline an invite", "security": [{"metallicUser": ["invites:write"]}],
    "parameters": [{"$ref": "#/components/parameters/InviteId"}],
    "x-metallic-upstream": {"method": "POST", "path": "/v1/invites/{invite_id}/decline"},
    "responses": {"200": {"description": "Declined", "content": {"application/json": {"schema": {"type": "object"}}}}}}
  },
  "/v1/news": {
   "get": {"operationId": "listNews", "tags": ["content"], "summary": "News posts", "security": [],
    "parameters": [{"name": "game", "in": "query", "schema": {"$ref": "#/components/schemas/GameId"}},
     {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}}],
    "responses": {"200": {"description": "News", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NewsList"}}}}, "502": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/games": {
   "get": {"operationId": "listGames", "tags": ["content"], "summary": "RC, MC, RB and PX status", "security": [],
    "responses": {"200": {"description": "Games", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GameList"}}}}}}
  },
  "/v1/games/{game}": {
   "get": {"operationId": "getGame", "tags": ["content"], "summary": "One game's status", "security": [],
    "parameters": [{"name": "game", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/GameId"}}],
    "responses": {"200": {"description": "Game", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Game"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/releases": {
   "get": {"operationId": "listReleases", "tags": ["content"], "summary": "Release channels", "security": [],
    "responses": {"200": {"description": "Channels", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChannelList"}}}}}}
  },
  "/v1/releases/{channel}": {
   "get": {"operationId": "getRelease", "tags": ["content"], "summary": "A verified release channel", "description": "Read from the signed channel files (Ed25519). A channel that fails verification is never served as verified: the answer is 503 `unverified`. The launcher still verifies the files itself before installing anything.", "security": [],
    "parameters": [{"name": "channel", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}}],
    "responses": {"200": {"description": "Channel", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Channel"}}}}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/progress": {
   "get": {"operationId": "getProgress", "tags": ["content"], "summary": "PX progress (public view)", "description": "The same data as the PX page in public mode: five honest states per item, no percentages.", "security": [],
    "responses": {"200": {"description": "Progress", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Progress"}}}}}}
  },
  "/v1/progress/{project}": {
   "get": {"operationId": "getProjectProgress", "tags": ["content"], "summary": "One project's progress", "security": [],
    "parameters": [{"name": "project", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z0-9-]{1,32}$"}}],
    "responses": {"200": {"description": "Project", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProgressProject"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/projects/status": {
   "get": {"operationId": "getProjectStatus", "tags": ["content"], "summary": "Litha and STAR status (read-only)", "security": [],
    "responses": {"200": {"description": "Status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectStatusList"}}}}}}
  },
  "/v1/servers/heartbeat": {
   "post": {"operationId": "serverHeartbeat", "tags": ["servers"], "summary": "Report a live game server", "description": "Send every 30-60 s. A server that stops reporting drops out after 90 s. Counts only, never player names.", "security": [{"serverKey": ["servers:write"]}],
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Heartbeat"}}}},
    "responses": {"200": {"description": "Recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/servers/events": {
   "post": {"operationId": "serverEvent", "tags": ["servers"], "summary": "Report a player joining or leaving (sends player.joined / player.left)", "description": "Pass the player's Metallic sign-in token as `player_token` to attach their account id (and, for adults, their username). Without it, only your own opaque `player_ref` is passed on.", "security": [{"serverKey": ["servers:write"]}],
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServerEvent"}}}},
    "responses": {"202": {"description": "Accepted and queued for webhooks", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventAccepted"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/players/verify": {
   "post": {"operationId": "verifyPlayer", "tags": ["servers"], "summary": "Check a player's Metallic sign-in token", "security": [{"serverKey": ["players:read"]}],
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlayerVerifyRequest"}}}},
    "responses": {"200": {"description": "Who the player is (minors without names)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlayerInfo"}}}}}}
  },
  "/v1/webhooks": {
   "get": {"operationId": "listWebhooks", "tags": ["webhooks"], "summary": "Your webhooks", "security": [{"serverKey": ["webhooks:manage"]}, {"metallicUser": ["webhooks:manage"]}],
    "responses": {"200": {"description": "Webhooks", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookList"}}}}}},
   "post": {"operationId": "createWebhook", "tags": ["webhooks"], "summary": "Add a webhook (the secret is shown once)", "security": [{"serverKey": ["webhooks:manage"]}, {"metallicUser": ["webhooks:manage"]}],
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookCreate"}}}},
    "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookCreated"}}}}, "400": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/webhooks/{webhook_id}": {
   "delete": {"operationId": "deleteWebhook", "tags": ["webhooks"], "summary": "Delete a webhook", "security": [{"serverKey": ["webhooks:manage"]}, {"metallicUser": ["webhooks:manage"]}],
    "parameters": [{"$ref": "#/components/parameters/WebhookId"}],
    "responses": {"200": {"description": "Deleted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/webhooks/{webhook_id}/deliveries": {
   "get": {"operationId": "listDeliveries", "tags": ["webhooks"], "summary": "Delivery log (newest first)", "security": [{"serverKey": ["webhooks:manage"]}, {"metallicUser": ["webhooks:manage"]}],
    "parameters": [{"$ref": "#/components/parameters/WebhookId"}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}}],
    "responses": {"200": {"description": "Deliveries", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeliveryList"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/webhooks/{webhook_id}/ping": {
   "post": {"operationId": "pingWebhook", "tags": ["webhooks"], "summary": "Send a signed `ping` event", "security": [{"serverKey": ["webhooks:manage"]}, {"metallicUser": ["webhooks:manage"]}],
    "parameters": [{"$ref": "#/components/parameters/WebhookId"}],
    "responses": {"202": {"description": "Queued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventAccepted"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/keys": {
   "get": {"operationId": "listKeys", "tags": ["admin"], "summary": "Server keys", "security": [{"metallicUser": ["keys:admin"]}],
    "responses": {"200": {"description": "Keys (never the secrets)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KeyList"}}}}}},
   "post": {"operationId": "createKey", "tags": ["admin"], "summary": "Create a server key (the secret is shown once)", "security": [{"metallicUser": ["keys:admin"]}],
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KeyCreate"}}}},
    "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KeyCreated"}}}}, "400": {"$ref": "#/components/responses/Error"}}}
  },
  "/v1/keys/{key_id}": {
   "delete": {"operationId": "revokeKey", "tags": ["admin"], "summary": "Revoke a server key", "security": [{"metallicUser": ["keys:admin"]}],
    "parameters": [{"name": "key_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^key_[a-z0-9]{8,32}$"}}],
    "responses": {"200": {"description": "Revoked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
  }
 },
 "webhooks": {
  "player.joined": {"post": {"summary": "A player joined a game server", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlayerEventPayload"}}}}, "responses": {"200": {"description": "Any 2xx counts as delivered"}}}},
  "player.left": {"post": {"summary": "A player left a game server", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlayerEventPayload"}}}}, "responses": {"200": {"description": "Any 2xx counts as delivered"}}}},
  "release.published": {"post": {"summary": "A release channel has a new signed manifest", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReleaseEventPayload"}}}}, "responses": {"200": {"description": "Any 2xx counts as delivered"}}}},
  "friend.added": {"post": {"summary": "Two accounts became friends (account ids only)", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/FriendEventPayload"}}}}, "responses": {"200": {"description": "Any 2xx counts as delivered"}}}},
  "ping": {"post": {"summary": "Test event from POST /v1/webhooks/{id}/ping", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventEnvelope"}}}}, "responses": {"200": {"description": "Any 2xx counts as delivered"}}}}
 },
 "components": {
  "securitySchemes": {
   "metallicUser": {"type": "http", "scheme": "bearer", "bearerFormat": "Metallic sign-in token (JWT) or scoped token (mtk_...)",
    "description": "The launcher's Metallic access token (first-party: every user scope; owner/admin also get keys:admin and webhooks:manage), or a scoped `mtk_` token from POST /v1/oauth/token that carries only its granted scopes."},
   "serverKey": {"type": "http", "scheme": "bearer", "bearerFormat": "msk_<id>_<secret>",
    "description": "Server-to-server key for game servers and backends. Keep it on the server: in Roblox store it as an HttpService secret and never send it to a client. Each key has scopes, a games list and its own rate limit."}
  },
  "parameters": {
   "Username": {"name": "username", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9_]{3,20}$"}},
   "InviteId": {"name": "invite_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^inv_[a-z0-9]{4,40}$"}},
   "WebhookId": {"name": "webhook_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^wh_[a-z0-9]{8,32}$"}}
  },
  "responses": {
   "Error": {"description": "Refused", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
  },
  "schemas": {
   "Error": {"type": "object", "required": ["ok", "error", "text"], "properties": {
    "ok": {"const": false}, "error": {"type": "string", "examples": ["insufficient_scope"]}, "text": {"type": "string"},
    "retry_after": {"type": "number"}, "scope": {"type": "string"}}},
   "Ok": {"type": "object", "required": ["ok"], "properties": {"ok": {"const": true}}},
   "Health": {"type": "object", "required": ["ok", "service", "version"], "properties": {
    "ok": {"type": "boolean"}, "service": {"const": "metallic-api"}, "version": {"type": "string"},
    "accounts": {"type": "string", "enum": ["up", "down"]}}},
   "GameId": {"type": "string", "enum": ["RC", "MC", "RB", "PX"]},
   "ScopeList": {"type": "object", "required": ["scopes"], "properties": {"scopes": {"type": "array", "items": {
